@page "/analytics"
@inherits PlannerPage
<PageTitle>Analytics · StudyFlow</PageTitle>
<header class="page-heading"><div><span class="eyebrow">SEE THE BIGGER PICTURE</span><h1>Analytics</h1><p>Real progress and remaining workload, calculated from your assignments.</p></div><a class="button secondary" href="/export" download="studyflow.json">Export JSON ↓</a></header>
<PlannerFeedback />
@{ var summary = AnalyticsRules.Summarize(Planner.Tasks, Today); var week = AnalyticsRules.Week(Planner.Tasks, Today); var maximum = Math.Max(1, week.Max(d => d.Minutes)); }
<div class="metrics"><StatCard Label="Completion" Value="@($"{summary.CompletionPercent}%")" Hint="Current assignment status" /><StatCard Label="Remaining effort" Value="@($"{summary.RemainingMinutes / 60.0:0.#} h")" Hint="Estimated, not tracked time" /><StatCard Label="Overdue" Value="@summary.Overdue.ToString()" Hint="Active assignments before today" /><StatCard Label="Active courses" Value="@Planner.Courses.Count(c => !c.Archived).ToString()" Hint="Archived courses excluded" /></div>
<div class="dashboard-grid"><section class="panel"><h2>Work due in the next 7 days</h2><p>Unfinished estimated minutes, grouped by deadline.</p>
<div class="bar-chart" role="img" aria-label="Upcoming daily workload in minutes">
@foreach (var day in week) { <div class="bar-column"><span>@day.Minutes</span><div class="bar-track"><div class="bar" style="height:@((int)(100.0 * day.Minutes / maximum))%"></div></div><strong>@day.Date.ToString("ddd")</strong><small>@day.Date.ToString("dd MMM")</small></div> }
</div><details><summary>View chart data</summary><ul>@foreach(var day in week) { <li>@day.Date.ToString("dd MMM"): @day.Minutes minutes, @day.Count assignments</li> }</ul></details></section>
<section class="panel"><h2>Completion by course</h2>
@if (!Planner.Courses.Any()) { <p class="empty">Add courses and assignments to see your progress.</p> }
@foreach (var course in AnalyticsRules.ByCourse(Planner.Courses, Planner.Tasks))
{
<div class="course-progress"><CoursePill Course="course.Course" /><div class="progress-label"><span>@course.Completed / @course.Total complete</span><span>@course.RemainingMinutes min left</span></div><progress max="@Math.Max(1, course.Total)" value="@course.Completed" aria-label="Completion for @course.Course.Name"></progress></div>
}
</section></div>
<section class="panel section-gap"><h2>What these numbers mean</h2><p>Completion reflects current task status. Reopening a task reduces completion. Remaining effort uses full estimates for unfinished tasks, including archived courses. Historical completion trends are not inferred because completion timestamps are not tracked.</p></section>

<section class="panel section-gap"><h2>Import JSON backup</h2>
<p>Merge courses, assignments, windows and saved sessions. Identical IDs are skipped; conflicting IDs or overlapping windows reject the entire import. Existing data is never overwritten. Maximum 2 MiB and 10,000 combined records.</p>
<label for="backup-file">Choose a StudyFlow JSON export</label><InputFile id="backup-file" accept=".json,application/json" OnChange="ReadBackup" disabled="@Planner.IsBusy" />
@if (importError is not null) { <p class="error" role="alert">@importError</p> }
@if (preview is not null)
{
    <p role="status">Validated backup: @preview.Courses.Count courses, @preview.Tasks.Count assignments, @preview.Windows.Count windows, @preview.Sessions.Count sessions.</p>
    <button class="button" disabled="@Planner.IsBusy" @onclick="Import">Import validated backup</button>
}
</section>
@code {
    private string? backupJson, importError;
    private StudyFlow.Application.Contracts.PlannerSnapshot? preview;
    private async Task ReadBackup(InputFileChangeEventArgs args)
    {
        backupJson = null; preview = null; importError = null;
        try
        {
            using var stream = args.File.OpenReadStream(BackupCodec.MaxBytes);
            using var reader = new System.IO.StreamReader(stream, new System.Text.UTF8Encoding(false, true));
            var json = await reader.ReadToEndAsync();
            var parsed = BackupCodec.Parse(json);
            importError = parsed.Error;
            if (parsed.IsSuccess) { backupJson = json; preview = parsed.Value; }
        }
        catch (Exception ex) when (ex is System.IO.IOException or System.Text.DecoderFallbackException)
        {
            importError = "Cannot read this file. Choose a UTF-8 JSON backup no larger than 2 MiB.";
        }
    }
    private async Task Import()
    {
        if (backupJson is null) return;
        await Planner.ImportAsync(backupJson);
        if (Planner.Error is null) { backupJson = null; preview = null; }
    }
}
